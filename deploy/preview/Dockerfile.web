# Multi-stage: el SDK de Flutter solo se utiliza durante compilación.
# Versión explícita disponible para linux/amd64 y linux/arm64.
FROM ghcr.io/cirruslabs/flutter:3.44.0 AS web_build

WORKDIR /source/clients/flutter
# Flutter requiere el catálogo base ES indicado en l10n.yaml.
COPY clients/flutter/pubspec.yaml ./
COPY clients/flutter/l10n.yaml ./l10n.yaml
# pub get genera locales automáticamente; los ARB deben existir antes.
COPY clients/flutter/lib/l10n ./lib/l10n
RUN flutter pub get
COPY clients/flutter/lib ./lib
COPY clients/flutter/web ./web
RUN flutter gen-l10n && flutter build web --release --pwa-strategy=none

FROM nginx:stable-alpine
COPY deploy/local-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web_build /source/clients/flutter/build/web/ /usr/share/nginx/html/
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=4s --retries=5 CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1
