# Keep secrets, host-local data and developer artifacts outside image build context.
.git
.gitignore
.env
.env.*
!.env.example
**/.env
**/.env.*
**/.git
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/node_modules/
**/.dart_tool/
**/build/
**/dist/
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*
**/*.bak
**/*.backup
**/*.dump
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
